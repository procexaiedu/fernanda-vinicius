NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MinIO (upload de fotos de produtos) — opcional, produto salva sem foto se ausente
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fv-products
MINIO_PUBLIC_URL=

# Emissão de NFC-e pelo sistema. Desligada se ausente (botão mostra "Em breve"
# e o servidor recusa). Ver src/lib/fiscal/emissaoAtiva.ts. Exige novo build.
NEXT_PUBLIC_EMISSAO_NOTA_ATIVA=false
